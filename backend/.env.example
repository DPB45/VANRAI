# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vanrai

# Secret used to sign JWTs — use a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Port the API listens on (Render/most hosts set this automatically)
PORT=5001

# Set to "production" in production. Also used to skip the dev-only seeding
# check in seedProducts().
NODE_ENV=development

# --- Email (Brevo SMTP relay) ---
EMAIL_USER=your_brevo_login_id
EMAIL_PASS=your_brevo_api_key

# The "From" address on outgoing emails. MUST be an address you've verified
# in Brevo, or sending will fail/land in spam.
SENDER_EMAIL=your_verified_sender@example.com

# --- Password reset ---
# Base URL of the deployed frontend, used to build the password-reset link
# emailed to users (e.g. https://vanrai.vercel.app). Falls back to the
# production Vercel URL if not set.
FRONTEND_URL=http://localhost:5173
