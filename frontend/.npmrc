# react-helmet-async@2.0.5's peer dependency range (React 16-18) hasn't been
# updated for React 19 yet, even though it works fine with it in practice.
# Without this, a plain `npm install` fails with an ERESOLVE conflict on
# any fresh clone or CI/deploy pipeline (Vercel, Render, etc. all run
# `npm install` by default).
legacy-peer-deps=true
